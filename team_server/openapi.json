              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "on_roster": {
            "title": "On Roster",
            "type": "boolean"
          }
        },
        "required": [
          "github_id",
          "login",
          "html_url",
          "on_roster"
        ],
        "title": "Resolved",
        "type": "object"
      },
      "Roster": {
        "properties": {
          "member_limit": {
