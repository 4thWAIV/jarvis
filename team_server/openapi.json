                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "ready"
        ],
        "title": "Ready",
        "type": "object"
      },
      "ResolveRequest": {
        "properties": {
          "login": {
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
            "title": "Login",
            "type": "string"
          }
        },
        "required": [
          "login"
        ],
        "title": "ResolveRequest",
        "type": "object"
      },
      "Resolved": {
        "properties": {
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
