          },
          "added_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Added At"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "github_id": {
            "title": "Github Id",
            "type": "integer"
          },
          "login": {
            "title": "Login",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          },
          "state": {
            "enum": [
              "approved",
              "active",
              "suspended"
            ],
            "title": "State",
            "type": "string"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "github_id",
          "login",
          "role",
          "state"
        ],
        "title": "Member",
        "type": "object"
      },
      "MemberChange": {
        "properties": {
          "expected_revision": {
            "minimum": 1.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "role": {
            "anyOf": [
              {
                "enum": [
                  "admin",
                  "member"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "approved",
                  "suspended",
                  "removed"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "approved: allow (new entry, or re-enable a suspended one); suspended: withdraw access and end their sessions; removed: delete an entry that never signed in.",
            "title": "Status"
          }
        },
        "required": [
          "expected_revision"
        ],
        "title": "MemberChange",
        "type": "object"
      },
      "MemberChanged": {
        "properties": {
          "member": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Member"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "member"
        ],
        "title": "MemberChanged",
        "type": "object"
      },
      "Ready": {
        "properties": {
          "ready": {
            "title": "Ready",
