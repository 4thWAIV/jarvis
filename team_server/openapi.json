          }
        },
        "required": [
          "revision",
          "member_limit",
          "members"
        ],
        "title": "Roster",
        "type": "object"
      },
      "SessionsRevoked": {
        "properties": {
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "session_generation": {
            "title": "Session Generation",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "session_generation"
        ],
        "title": "SessionsRevoked",
        "type": "object"
      },
      "Status": {
        "properties": {
          "me": {
            "$ref": "#/components/schemas/Me"
          },
          "recent_auth_until": {
            "format": "date-time",
            "title": "Recent Auth Until",
            "type": "string"
          },
          "server_id": {
            "title": "Server Id",
            "type": "string"
          },
          "server_time": {
            "format": "date-time",
