          "server_time",
          "server_id",
          "session_expires_at",
          "session_kind",
          "recent_auth_until",
          "team",
          "me"
        ],
        "title": "Status",
        "type": "object"
      },
      "Team": {
        "properties": {
          "member_count": {
            "title": "Member Count",
            "type": "integer"
          },
          "member_limit": {
            "title": "Member Limit",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "server_id": {
            "title": "Server Id",
            "type": "string"
          }
        },
        "required": [
          "name",
          "server_id",
          "member_count",
          "member_limit"
        ],
        "title": "Team",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Version": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "integer"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "server_id": {
            "anyOf": [
