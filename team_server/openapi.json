{
  "components": {
    "schemas": {
      "DeviceDecided": {
        "properties": {
          "device_name": {
            "title": "Device Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "approved",
              "denied"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "device_name"
        ],
        "title": "DeviceDecided",
        "type": "object"
      },
      "DeviceDecision": {
        "properties": {
          "decision": {
            "enum": [
              "approve",
              "deny"
            ],
            "title": "Decision",
            "type": "string"
          },
          "user_code": {
            "maxLength": 9,
            "minLength": 8,
            "title": "User Code",
            "type": "string"
          }
        },
        "required": [
          "user_code",
          "decision"
        ],
        "title": "DeviceDecision",
        "type": "object"
      },
      "DeviceExchange": {
        "properties": {
          "code_verifier": {
            "maxLength": 128,
            "minLength": 43,
            "title": "Code Verifier",
            "type": "string"
          },
          "poll_token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Poll Token",
            "type": "string"
          }
        },
        "required": [
          "poll_token",
          "code_verifier"
        ],
        "title": "DeviceExchange",
        "type": "object"
      },
      "DevicePending": {
        "properties": {
          "interval": {
            "title": "Interval",
            "type": "integer"
          },
          "status": {
            "const": "authorization_pending",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "interval"
        ],
        "title": "DevicePending",
        "type": "object"
      },
      "DeviceSession": {
        "properties": {
          "me": {
            "$ref": "#/components/schemas/Me"
          },
          "server_id": {
            "title": "Server Id",
            "type": "string"
          },
          "session_expires_at": {
            "format": "date-time",
            "title": "Session Expires At",
            "type": "string"
          },
          "session_token": {
            "title": "Session Token",
            "type": "string"
          },
          "status": {
            "const": "approved",
            "title": "Status",
            "type": "string"
          },
          "team": {
            "$ref": "#/components/schemas/Team"
          }
        },
        "required": [
          "status",
          "session_token",
          "session_expires_at",
          "server_id",
          "team",
          "me"
        ],
        "title": "DeviceSession",
        "type": "object"
      },
      "DeviceStart": {
        "properties": {
          "code_challenge": {
            "description": "BASE64URL(SHA256(verifier)), no padding",
            "maxLength": 43,
            "minLength": 43,
            "title": "Code Challenge",
            "type": "string"
          },
          "code_challenge_method": {
            "const": "S256",
            "default": "S256",
            "title": "Code Challenge Method",
            "type": "string"
          },
          "device_name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Device Name",
            "type": "string"
          }
        },
        "required": [
          "device_name",
          "code_challenge"
        ],
        "title": "DeviceStart",
        "type": "object"
      },
      "DeviceStarted": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "interval": {
            "title": "Interval",
            "type": "integer"
          },
          "poll_token": {
            "title": "Poll Token",
            "type": "string"
          },
          "user_code": {
            "title": "User Code",
            "type": "string"
          },
          "verification_uri": {
            "title": "Verification Uri",
            "type": "string"
          },
          "verification_uri_complete": {
            "title": "Verification Uri Complete",
            "type": "string"
          }
        },
        "required": [
          "user_code",
          "verification_uri",
          "verification_uri_complete",
          "poll_token",
          "expires_at",
          "interval"
        ],
        "title": "DeviceStarted",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Live": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Live",
        "type": "object"
      },
      "LoggedOut": {
        "properties": {
          "revoked": {
            "title": "Revoked",
            "type": "boolean"
          }
        },
        "required": [
          "revoked"
        ],
        "title": "LoggedOut",
        "type": "object"
      },
      "Me": {
        "properties": {
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "github_id": {
            "title": "Github Id",
            "type": "integer"
          },
          "login": {
            "title": "Login",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          },
          "state": {
            "enum": [
              "approved",
              "active",
              "suspended"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "github_id",
          "login",
          "role",
          "state"
        ],
        "title": "Me",
        "type": "object"
      },
      "Member": {
        "properties": {
          "activated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
