{
  "family": "work",
  "owner": "coverage-main",
  "views": [],
  "commands": [
    {"id": "work.tab.select", "label": "Show one of the open work item's tabs",
     "view": "main.work",
     "args": {"itemId": {"type": "key", "entity": "workItem"},
              "tab": {"type": "enum", "values": ["messages", "overview", "blocking", "pieces", "reports"]}},
     "required": ["itemId", "tab"], "actors": ["human", "brain"], "effects": []},
    {"id": "work.showHistory", "label": "Show or hide the Work tab's History: items closed, or done a while",
     "view": "right.workflows",
     "args": {"shown": {"type": "boolean"}},
     "required": ["shown"], "actors": ["human", "brain"], "effects": [{"effect": "list.filtered"}]}
  ],
  "kinds": [
    {"kind": "workList", "entity": null, "label": "Work list", "parts": ["list", "showHistory", "history"],
     "presentations": [{"view": "right.workflows", "reveal": {"command": "right.tab.select", "args": {"tab": "workflows"}}}]},
    {"kind": "workGroup", "entity": "workGroup", "label": "Work group", "parts": ["head"],
     "presentations": [{"view": "right.workflows", "reveal": {"command": "right.tab.select", "args": {"tab": "workflows"}}}]},
    {"kind": "workItem", "entity": "workItem", "label": "Work item",
     "parts": ["row", "state", "update", "mark", "decisionCount", "messageCount", "blocker", "activity", "project", "header", "takeover", "close", "banner", "source",
               "who", "itemKeys", "pieces", "messages", "blocking", "reports", "review", "needs", "tab.messages", "tab.overview", "tab.blocking", "tab.pieces", "tab.reports"],
     "presentations": [{"view": "right.workflows", "parts": ["row", "state", "update", "mark", "decisionCount", "messageCount", "blocker", "activity", "project"],
                        "reveal": {"command": "right.tab.select", "args": {"tab": "workflows"}}},
                       {"view": "main.work", "parts": ["header", "state", "update", "takeover", "close", "banner", "source", "project", "who", "itemKeys", "pieces",
                                                  "messages", "blocking", "reports", "review", "needs", "tab.messages", "tab.overview", "tab.blocking", "tab.pieces", "tab.reports"],
                        "reveal": {"command": "work.open", "args": {"itemId": "$key"}}}]},
    {"kind": "workPiece", "entity": null, "keyOf": ["workItem", "workPart"], "label": "Work piece",
     "parts": ["row", "who", "worker", "reporter", "state", "mark", "activity", "note", "after", "evidence"],
     "presentations": [{"view": "main.work"}]},
    {"kind": "workDecision", "entity": null, "keyOf": ["workItem", "workPart"], "label": "Work decision",
     "parts": ["row", "options", "answer", "package"], "presentations": [{"view": "main.work"}]},
    {"kind": "workBlocker", "entity": null, "keyOf": ["workItem", "workBlocker"], "label": "What holds a work item up",
     "parts": ["row"], "presentations": [{"view": "main.work"}]}
  ]
}
