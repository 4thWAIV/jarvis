{
  "family": "workflows",
  "owner": "coverage-main",
  "views": [],
  "commands": [
    {"id": "workflows.showDone", "label": "Show or hide the finished workflows under Done in the right panel's Workflows tab",
     "view": "right.workflows",
     "args": {"shown": {"type": "boolean"}},
     "required": ["shown"], "actors": ["human", "brain"], "effects": [{"effect": "list.filtered"}]},
    {"id": "workflow.tab.select", "label": "Show one of the open workflow's tabs",
     "view": "main.workflow",
     "args": {"workflowId": {"type": "key", "entity": "workflow"},
              "tab": {"type": "enum", "values": ["overview", "phases", "tasks", "transcript", "progress",
                                                 "waits", "decisions", "blockers", "events"]}},
     "required": ["workflowId", "tab"], "actors": ["human", "brain"], "effects": []},
    {"id": "workflow.events.filter", "label": "Show the open workflow's events of one kind; without a kind, every kind",
     "view": "main.workflow",
     "args": {"workflowId": {"type": "key", "entity": "workflow"},
              "kind": {"type": "string", "maxLength": 64}},
     "required": ["workflowId"], "actors": ["human", "brain"], "effects": [{"effect": "list.filtered"}]},
    {"id": "workflow.transcript.earlier", "label": "Load the earlier page of one transcript shown in the workflow view",
     "view": "main.workflow",
     "args": {"sessionId": {"type": "key", "entity": "session"},
              "agentId": {"type": "key", "entity": "subagent"}},
     "required": ["sessionId"], "actors": ["human", "brain"], "effects": [{"effect": "list.paged"}]}
  ],
  "kinds": [
    {"kind": "workflowsList", "entity": null, "label": "Workflows list", "parts": ["showDone"],
     "presentations": [{"view": "right.workflows", "reveal": {"command": "right.tab.select", "args": {"tab": "workflows"}}}]},
    {"kind": "workflow", "entity": "workflow", "label": "Workflow",
     "parts": ["row", "state", "tasks", "header", "close", "dismiss",
               "tab.overview", "tab.phases", "tab.tasks", "tab.transcript", "tab.progress",
               "tab.waits", "tab.decisions", "tab.blockers", "tab.events"],
     "presentations": [{"view": "right.workflows", "parts": ["row", "state", "tasks", "dismiss"],
                        "reveal": {"command": "right.tab.select", "args": {"tab": "workflows"}}},
                       {"view": "main.workflow", "parts": ["header", "state", "close", "dismiss",
                        "tab.overview", "tab.phases", "tab.tasks", "tab.transcript", "tab.progress",
                        "tab.waits", "tab.decisions", "tab.blockers", "tab.events"],
                        "reveal": {"command": "workflow.open", "args": {"workflowId": "$key"}}}]},
    {"kind": "workflowPhase", "entity": null, "keyOf": ["workflow", "workflowItem"], "label": "Workflow phase",
     "parts": ["row", "state", "progress", "activity"], "presentations": [{"view": "main.workflow"}]},
    {"kind": "workflowTask", "entity": null, "keyOf": ["workflow", "workflowItem"], "label": "Workflow task",
     "parts": ["row", "state", "progress", "activity"], "presentations": [{"view": "main.workflow"}]},
    {"kind": "workflowDecision", "entity": null, "keyOf": ["workflow", "workflowItem"], "label": "Workflow decision",
     "parts": ["row", "options", "answer"], "presentations": [{"view": "main.workflow"}]},
    {"kind": "workflowWait", "entity": null, "keyOf": ["workflow", "workflowItem"], "label": "Workflow wait",
     "parts": ["row"], "presentations": [{"view": "main.workflow"}]},
    {"kind": "workflowBlocker", "entity": null, "keyOf": ["workflow", "workflowItem"], "label": "Workflow blocker",
     "parts": ["row"], "presentations": [{"view": "main.workflow"}]},
    {"kind": "workflowTranscript", "entity": "workflow", "label": "Workflow transcript", "parts": ["list"],
     "presentations": [{"view": "main.workflow"}]},
    {"kind": "workflowAgent", "entity": null, "keyOf": ["workflow", "session"], "label": "Attached agent's transcript",
     "parts": ["section", "entries", "earlier"], "presentations": [{"view": "main.workflow"}]},
    {"kind": "workflowEvents", "entity": "workflow", "label": "Workflow events", "parts": ["list", "filter"],
     "presentations": [{"view": "main.workflow"}]},
    {"kind": "subagent", "entity": null, "keyOf": ["session", "subagent"], "label": "Subagent",
     "parts": ["row", "state", "header", "close", "transcript", "earlier"],
     "presentations": [{"view": "right.workflows", "parts": ["row", "state"], "reveal": {"command": "right.tab.select", "args": {"tab": "workflows"}}},
                       {"view": "main.workflow", "parts": ["row", "state", "header", "close", "transcript", "earlier"]}]}
  ]
}
