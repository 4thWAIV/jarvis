{
  "family": "settings",
  "owner": "coverage-left-settings",
  "views": [],
  "commands": [
    {"id": "menu.toggle", "label": "Open or close the menu (top right)",
     "view": "overlay.controls", "args": {"open": {"type": "boolean"}},
     "required": ["open"], "actors": ["human", "brain"],
     "effects": [{"effect": "menu.opened", "when": {"open": true}}]},
    {"id": "settings.open",
     "label": "Open Settings in the centre, at one section if one is named; the menu closes. setup: first-time setup (a welcome, then Voice, then You)",
     "view": "main.settings",
     "args": {"section": {"type": "enum", "values": ["you", "voice", "brains", "team", "updates", "server"]},
              "setup": {"type": "boolean"}},
     "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "settings.opened"}, {"effect": "centre.view-shown"}, {"effect": "layout.restored"}]},
    {"id": "settings.section", "label": "Go to one section of Settings while it is open",
     "view": "main.settings",
     "args": {"section": {"type": "enum", "values": ["you", "voice", "brains", "team", "updates", "server"]}},
     "required": ["section"], "actors": ["human", "brain"], "effects": []},
    {"id": "settings.close", "label": "Close Settings (first-time setup ends with it); the centre goes back to Conversation",
     "view": "main.settings", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.detail-closed"}, {"effect": "layout.restored"}]},
    {"id": "reminder.later",
     "label": "Hide the sign-in reminder until the page or its connection to JARVIS starts again",
     "view": "main.notice", "args": {}, "required": [], "actors": ["human", "brain"], "effects": []},
    {"id": "updates.review",
     "label": "Open or close the list of updates waiting (Review updates), at the top of the centre",
     "view": "main.notice", "args": {"open": {"type": "boolean"}}, "required": ["open"],
     "actors": ["human", "brain"], "effects": []}
  ],
  "kinds": [
    {"kind": "menu", "entity": null, "label": "Menu", "parts": ["toggle", "settings", "updates", "restart"],
     "presentations": [{"view": "overlay.controls", "parts": ["toggle"]},
                       {"view": "overlay.menu", "parts": ["settings", "updates", "restart"],
                        "reveal": {"command": "menu.toggle", "args": {"open": true}}}]},
    {"kind": "settings", "entity": null,
     "label": "Settings; a part named after a section is that section's name in the row that jumps to it",
     "parts": ["close", "nav", "setup", "you", "voice", "brains", "team", "updates", "server"],
     "presentations": [{"view": "main.settings",
                        "reveal": {"command": "settings.open", "args": {}}}]},
    {"kind": "settingsSection", "entity": "settingsSection", "label": "Settings section",
     "parts": ["heading", "body"],
     "presentations": [{"view": "main.settings",
                        "reveal": {"command": "settings.open", "args": {"section": "$key"}}}]},
    {"kind": "settingsItem", "entity": null, "label": "One control or reading in Settings, by its name",
     "parts": ["label"],
     "keys": ["name", "honorific", "saveYou", "steady",
              "language", "spanishModel", "voiceInputStop", "voiceInputSwitch", "voicePatience", "captureSounds", "cueStart", "cueStartTest", "cueStop", "cueStopTest", "cueHeard", "cueHeardTest",
              "intervalTentative", "cueTentative", "cueTentativeTest", "intervalDeciding", "cueDeciding",
              "cueDecidingTest", "intervalLikely", "cueLikely", "cueLikelyTest", "intervalSend",
              "cueVolume", "voiceId", "saveVoiceId", "fishKey", "testFishKey", "saveFishKey",
              "voiceOutputProvider", "localVoice", "installLocalVoice", "previewVoice", "appearance",
              "teamState", "teamAddress", "teamSignIn", "teamApproval", "teamCancel", "teamSignInAgain",
              "teamDisconnect", "teamLogin", "teamLookUp", "teamRole", "teamAdd", "teamAddCancel",
              "currentVersion", "checkUpdates", "installUpdate", "languageKit",
              "serverPort", "serverUptime"],
     "presentations": [{"view": "main.settings",
                        "reveal": {"command": "settings.open", "args": {}}}]},
    {"kind": "brainCard", "entity": "provider", "label": "A brain's card in Settings",
     "parts": ["model", "checks", "signIn", "startWith", "remove"],
     "presentations": [{"view": "main.settings",
                        "reveal": {"command": "settings.open", "args": {"section": "brains"}}}]},
    {"kind": "brainAdd", "entity": "provider", "label": "Add a brain", "parts": [],
     "presentations": [{"view": "main.settings",
                        "reveal": {"command": "settings.open", "args": {"section": "brains"}}}]},
    {"kind": "teamMember", "entity": "teamMember", "label": "A team member in Settings",
     "parts": ["name", "role", "actions"],
     "presentations": [{"view": "main.settings",
                        "reveal": {"command": "settings.open", "args": {"section": "team"}}}]},
    {"kind": "updateVersion", "entity": "version", "label": "A version offered in Settings, Updates",
     "parts": ["choose", "ci"],
     "presentations": [{"view": "main.settings",
                        "reveal": {"command": "settings.open", "args": {"section": "updates"}}}]},
    {"kind": "teamReminder", "entity": null, "label": "Sign-in reminder", "parts": ["text", "signIn", "later"],
     "presentations": [{"view": "main.notice"}]},
    {"kind": "updatesNotice", "entity": null,
     "label": "Updates waiting: their count, Review updates, Mark all seen, Hold spoken updates and the list",
     "parts": ["text", "review", "markSeen", "away", "list"],
     "presentations": [{"view": "main.notice"}]},
    {"kind": "footer", "entity": null, "label": "Footer", "parts": ["label"],
     "presentations": [{"view": "footer.fixed"}]}
  ]
}
