{
  "family": "settings",
  "owner": "coverage-left-settings",
  "views": [],
  "commands": [
    {"id": "menu.toggle", "label": "Open or close the menu (top right)",
     "view": "overlay.controls", "args": {"open": {"type": "boolean"}},
     "required": ["open"], "actors": ["human", "brain"],
     "effects": [{"effect": "menu.opened", "when": {"open": true}}]},
    {"id": "settings.open", "label": "Open Settings, at one section if one is named; the menu closes",
     "view": "overlay.settings",
     "args": {"section": {"type": "enum", "values": ["brains", "voice", "you", "team", "updates", "system"]}},
     "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "settings.opened"}]},
    {"id": "settings.section", "label": "Go to one section of Settings while it is open",
     "view": "overlay.settings",
     "args": {"section": {"type": "enum", "values": ["brains", "voice", "you", "team", "updates", "system"]}},
     "required": ["section"], "actors": ["human", "brain"], "effects": []},
    {"id": "settings.close", "label": "Close Settings (first-time setup ends with it)",
     "view": "overlay.settings", "args": {}, "required": [], "actors": ["human", "brain"], "effects": []},
    {"id": "reminder.later",
     "label": "Hide the sign-in reminder until the page or its connection to JARVIS starts again",
     "view": "main.notice", "args": {}, "required": [], "actors": ["human", "brain"], "effects": []}
  ],
  "kinds": [
    {"kind": "menu", "entity": null, "label": "Menu", "parts": ["toggle", "settings", "updates", "restart"],
     "presentations": [{"view": "overlay.controls", "parts": ["toggle"]},
                       {"view": "overlay.menu", "parts": ["settings", "updates", "restart"],
                        "reveal": {"command": "menu.toggle", "args": {"open": true}}}]},
    {"kind": "settings", "entity": null, "label": "Settings", "parts": ["close", "nav"],
     "presentations": [{"view": "overlay.settings",
                        "reveal": {"command": "settings.open", "args": {}}}]},
    {"kind": "settingsSection", "entity": "settingsSection", "label": "Settings section",
     "parts": ["heading", "body"],
     "presentations": [{"view": "overlay.settings",
                        "reveal": {"command": "settings.open", "args": {"section": "$key"}}}]},
    {"kind": "teamReminder", "entity": null, "label": "Sign-in reminder", "parts": ["text", "signIn", "later"],
     "presentations": [{"view": "main.notice"}]},
    {"kind": "footer", "entity": null, "label": "Footer", "parts": ["label"],
     "presentations": [{"view": "footer.fixed"}]}
  ]
}
