{
  "family": "usage",
  "owner": "coverage-main",
  "views": [],
  "commands": [
    {
      "id": "usage.open",
      "label": "Open one brain's usage history in the centre: what is left of each of its windows over time, and its latest reading",
      "view": "main.usage",
      "args": {
        "provider": {
          "type": "key",
          "entity": "provider"
        }
      },
      "required": [
        "provider"
      ],
      "actors": [
        "human",
        "brain"
      ],
      "effects": [
        {
          "effect": "centre.view-shown"
        },
        {
          "effect": "centre.detail-replaced"
        },
        {
          "effect": "layout.restored"
        }
      ]
    },
    {
      "id": "usage.close",
      "label": "Close the usage history",
      "view": "main.usage",
      "args": {},
      "required": [],
      "actors": [
        "human",
        "brain"
      ],
      "effects": [
        {
          "effect": "centre.detail-closed"
        },
        {
          "effect": "layout.restored"
        }
      ]
    },
    {
      "id": "usage.range",
      "label": "Show the open usage history over the last day, week or month, or all of it",
      "view": "main.usage",
      "args": {
        "range": {
          "type": "enum",
          "values": [
            "day",
            "week",
            "month",
            "all"
          ]
        }
      },
      "required": [
        "range"
      ],
      "actors": [
        "human",
        "brain"
      ],
      "effects": [
        {
          "effect": "list.filtered"
        }
      ]
    }
  ],
  "kinds": [
    {
      "kind": "usageHistory",
      "entity": "provider",
      "label": "One brain's usage history",
      "parts": [
        "header",
        "close",
        "range",
        "charts"
      ],
      "presentations": [
        {
          "view": "main.usage",
          "reveal": {
            "command": "usage.open",
            "args": {
              "provider": "$key"
            }
          }
        }
      ]
    },
    {
      "kind": "usageChart",
      "entity": "usageSeries",
      "label": "What is left of one brain's window over time",
      "parts": [
        "title",
        "latest",
        "chart"
      ],
      "presentations": [
        {
          "view": "main.usage"
        }
      ]
    }
  ]
}
