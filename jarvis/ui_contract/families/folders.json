{
  "family": "folders",
  "owner": "coverage-main",
  "views": [],
  "commands": [
    {"id": "folders.list", "label": "Show the registered folders or what discovery found, in the centre's Folders view",
     "view": "main.folders",
     "args": {"view": {"type": "enum", "values": ["registered", "discovered"]}},
     "required": ["view"], "actors": ["human", "brain"], "effects": [{"effect": "list.filtered"}]},
    {"id": "folders.search", "label": "Search the centre's folder list by name or path; without text the search is cleared",
     "view": "main.folders",
     "args": {"text": {"type": "string", "maxLength": 200}},
     "required": [], "actors": ["human", "brain"], "effects": [{"effect": "list.filtered"}]},
    {"id": "folders.panel.search", "label": "Filter the right panel's folder list by name or path; without text the filter is cleared",
     "view": "right.folders",
     "args": {"text": {"type": "string", "maxLength": 200}},
     "required": [], "actors": ["human", "brain"], "effects": [{"effect": "list.filtered"}]},
    {"id": "folders.filter", "label": "Filter the centre's folder list by role and availability, and show or hide removed and ignored folders",
     "view": "main.folders",
     "args": {"role": {"type": "enum", "values": ["any", "data", "source", "history"]},
              "availability": {"type": "enum", "values": ["any", "available", "missing", "access_denied", "unavailable_node"]},
              "removed": {"type": "boolean"},
              "ignored": {"type": "boolean"}},
     "required": [], "actors": ["human", "brain"], "effects": [{"effect": "list.filtered"}]},
    {"id": "folders.add.open", "label": "Open or close the Add existing folder form (nothing is checked or saved)",
     "view": "main.folders",
     "args": {"open": {"type": "boolean"}},
     "required": ["open"], "actors": ["human", "brain"], "effects": []},
    {"id": "folder.browse", "label": "Show one directory of the selected folder; without a path, its top",
     "view": "main.folders",
     "args": {"folderId": {"type": "key", "entity": "folder"},
              "path": {"type": "string", "maxLength": 512},
              "revision": {"type": "integer", "min": 0}},
     "required": ["folderId"], "actors": ["human", "brain"], "effects": [{"effect": "list.paged"}]},
    {"id": "folder.preview", "label": "Preview one file of the selected folder, or close the preview",
     "view": "main.folders",
     "args": {"folderId": {"type": "key", "entity": "folder"},
              "path": {"type": "string", "maxLength": 512},
              "revision": {"type": "integer", "min": 0}},
     "required": ["folderId"], "actors": ["human", "brain"], "effects": []},
    {"id": "folder.more", "label": "Load more of the selected folder's directory or of its file preview",
     "view": "main.folders",
     "args": {"folderId": {"type": "key", "entity": "folder"},
              "list": {"type": "enum", "values": ["entries", "preview"]}},
     "required": ["folderId", "list"], "actors": ["human", "brain"], "effects": [{"effect": "list.paged"}]}
  ],
  "kinds": [
    {"kind": "foldersList", "entity": null, "label": "Folder catalog",
     "parts": ["search", "open", "role", "availability", "registered", "discovered", "ignored", "removed", "add", "list"],
     "presentations": [{"view": "right.folders", "parts": ["search", "open"], "reveal": {"command": "right.tab.select", "args": {"tab": "folders"}}},
                       {"view": "main.folders", "parts": ["search", "role", "availability", "registered", "discovered",
                                                         "ignored", "removed", "add", "list"],
                        "reveal": {"command": "main.tab.select", "args": {"tab": "folders"}}}]},
    {"kind": "folder", "entity": "folder", "label": "Folder",
     "parts": ["row", "name", "availability", "detail", "location", "contents", "preview", "close"],
     "presentations": [{"view": "right.folders", "parts": ["row", "name", "availability"], "reveal": {"command": "right.tab.select", "args": {"tab": "folders"}}},
                       {"view": "main.folders", "parts": ["detail", "name", "availability", "location", "contents", "preview", "close"],
                        "reveal": {"command": "folders.open", "args": {"folderId": "$key"}}}]},
    {"kind": "folderRow", "entity": "folder", "label": "Folder in the catalog list", "parts": ["row", "name", "availability"],
     "presentations": [{"view": "main.folders", "reveal": {"command": "main.tab.select", "args": {"tab": "folders"}}}]},
    {"kind": "folderEntry", "entity": null, "keyOf": ["folder", "folderEntry"], "label": "Folder entry",
     "parts": ["row", "crumb"], "presentations": [{"view": "main.folders"}]},
    {"kind": "folderCandidate", "entity": "candidate", "label": "Discovered folder", "parts": ["row", "path", "actions"],
     "presentations": [{"view": "main.folders"}]}
  ]
}
