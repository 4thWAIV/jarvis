{
  "family": "navigation",
  "owner": "navigation",
  "views": [],
  "commands": [
    {"id": "work.open", "label": "Open one work item's detail in the centre, on its first tab or the one named; the Work list stays in view",
     "view": "main.work", "args": {"itemId": {"type": "key", "entity": "workItem"},
                                   "tab": {"type": "enum", "values": ["overview", "decisions", "blocking", "pieces", "reports"]}},
     "required": ["itemId"], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"}]},
    {"id": "work.close", "label": "Close the work item's detail",
     "view": "main.work", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.detail-closed"}]},
    {"id": "workflow.open", "label": "Open one workflow's detail in the centre, on its first tab or the one named",
     "view": "main.workflow",
     "args": {"workflowId": {"type": "key", "entity": "workflow"},
              "tab": {"type": "enum", "values": ["overview", "phases", "tasks", "transcript", "progress", "waits",
                                                 "decisions", "blockers", "events"]}},
     "required": ["workflowId"], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"}]},
    {"id": "subagent.open", "label": "Open one subagent's detail in the centre, in the workflow slot",
     "view": "main.workflow",
     "args": {"sessionId": {"type": "key", "entity": "session"}, "agentId": {"type": "key", "entity": "subagent"}},
     "required": ["sessionId", "agentId"], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"}]},
    {"id": "workflow.close", "label": "Close the workflow or subagent detail",
     "view": "main.workflow", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.detail-closed"}]},
    {"id": "thread.open", "label": "Open one agent's thread in the centre",
     "view": "main.thread", "args": {"sessionId": {"type": "key", "entity": "session"}},
     "required": ["sessionId"], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"}]},
    {"id": "thread.close", "label": "Close the agent's thread",
     "view": "main.thread", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.detail-closed"}]},
    {"id": "voice.diagnostics.open", "label": "Open voice diagnostics in the centre",
     "view": "main.diagnostics", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}]},
    {"id": "voice.diagnostics.close", "label": "Close voice diagnostics",
     "view": "main.diagnostics", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.detail-closed"}]},
    {"id": "subsystem.open", "label": "Open one subsystem's detail in the centre (voice input opens voice diagnostics)",
     "view": "main.subsystem", "args": {"subsystemId": {"type": "key", "entity": "subsystem"}},
     "required": ["subsystemId"], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"},
                 {"effect": "centre.detail-closed"}]},
    {"id": "subsystem.close", "label": "Close the subsystem's detail",
     "view": "main.subsystem", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.detail-closed"}]},
    {"id": "queue.open", "label": "Open one Queue item in the centre; a waiting one becomes Active",
     "view": "main.queue", "args": {"threadId": {"type": "key", "entity": "thread"}},
     "required": ["threadId"], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"},
                 {"effect": "queue.item-activated"}, {"effect": "queue.read-marked"},
                 {"effect": "queue.draft-saved"}]},
    {"id": "queue.follow", "label": "Follow a link to another Queue item without changing its place",
     "view": "main.queue", "args": {"threadId": {"type": "key", "entity": "thread"}},
     "required": ["threadId"], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"},
                 {"effect": "queue.read-marked"}, {"effect": "queue.draft-saved"}]},
    {"id": "queue.back", "label": "Go back to the Queue item a link was followed from",
     "view": "main.queue", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"},
                 {"effect": "queue.read-marked"}, {"effect": "queue.draft-saved"}]},
    {"id": "queue.next", "label": "Open the next waiting Queue item; it becomes Active",
     "view": "main.queue", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"},
                 {"effect": "queue.item-activated"}, {"effect": "queue.read-marked"},
                 {"effect": "queue.draft-saved"}]},
    {"id": "queue.close", "label": "Close the Queue item; its draft is saved",
     "view": "main.queue", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.detail-closed"}, {"effect": "queue.draft-saved"}]},
    {"id": "folders.open", "label": "Select one folder and show it in the centre's Folders view",
     "view": "main.folders", "args": {"folderId": {"type": "key", "entity": "folder"}},
     "required": ["folderId"], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}]},
    {"id": "folders.close", "label": "Close the selected folder; the Folders view shows the catalog",
     "view": "main.folders", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": []}
  ],
  "kinds": []
}
