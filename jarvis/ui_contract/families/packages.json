{
  "family": "packages",
  "owner": "integrator",
  "views": [],
  "commands": [
    {"id": "package.open", "label": "Open a page work package in the centre",
     "view": "main.package", "args": {"packageId": {"type": "key", "entity": "package"}},
     "required": ["packageId"], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"}, {"effect": "layout.restored"}]},
    {"id": "package.close", "label": "Close the work package page",
     "view": "main.package", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.detail-closed"}, {"effect": "layout.restored"}]},
    {"id": "bundle.member.open", "label": "Open a file a teammate sent, or one file inside it, in the centre",
     "view": "main.file",
     "args": {"messageId": {"type": "key", "entity": "message"}, "attachmentId": {"type": "key", "entity": "attachment"},
              "memberId": {"type": "key", "entity": "member"}},
     "required": ["messageId", "attachmentId", "memberId"], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"}, {"effect": "layout.restored"}]},
    {"id": "bundle.member.close", "label": "Close the received file",
     "view": "main.file", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.detail-closed"}, {"effect": "layout.restored"}]},
    {"id": "bundle.contents", "label": "Show or hide what an archive a teammate sent holds, on its file in the open Queue item",
     "view": "main.queue",
     "args": {"messageId": {"type": "key", "entity": "message"}, "attachmentId": {"type": "key", "entity": "attachment"},
              "shown": {"type": "boolean"}},
     "required": ["messageId", "attachmentId", "shown"], "actors": ["human", "brain"],
     "effects": [{"effect": "list.paged", "when": {"shown": true}}]},
    {"id": "bundle.folder", "label": "Show one folder of an archive's contents ('' is its top)",
     "view": "main.queue",
     "args": {"messageId": {"type": "key", "entity": "message"}, "attachmentId": {"type": "key", "entity": "attachment"},
              "folder": {"type": "string", "maxLength": 512}},
     "required": ["messageId", "attachmentId", "folder"], "actors": ["human", "brain"],
     "effects": [{"effect": "list.paged"}]},
    {"id": "bundle.folder.more", "label": "Read the next page of the archive folder shown",
     "view": "main.queue",
     "args": {"messageId": {"type": "key", "entity": "message"}, "attachmentId": {"type": "key", "entity": "attachment"}},
     "required": ["messageId", "attachmentId"], "actors": ["human", "brain"],
     "effects": [{"effect": "list.paged"}]},
    {"id": "bundle.member.view", "label": "Show the open received file as its preview or its text, or turn to one of its pages",
     "view": "main.file",
     "args": {"show": {"type": "enum", "values": ["preview", "text"]}, "page": {"type": "integer", "min": 1}},
     "required": [], "actors": ["human", "brain"], "effects": []},
    {"id": "bundle.member.more", "label": "Read the next page of the open received file's text",
     "view": "main.file", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "list.paged"}]}
  ],
  "kinds": [
    {"kind": "packageView", "entity": "package", "label": "Work package page", "parts": ["header", "frame", "done", "close", "story", "tell", "fromSlide", "resume", "stop"],
     "presentations": [{"view": "main.package",
                        "reveal": {"command": "package.open", "args": {"packageId": "$key"}}}]},
    {"kind": "bundleMember", "entity": "member", "label": "Received file", "parts": ["header", "show", "close", "pages", "body", "more"],
     "presentations": [{"view": "main.file"}]}
  ]
}
