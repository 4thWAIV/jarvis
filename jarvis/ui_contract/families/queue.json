{
  "family": "queue",
  "owner": "coverage-right",
  "views": [],
  "commands": [
    {"id": "queue.history", "label": "Show or hide the Queue's dismissed items; showing reads their first page",
     "view": "right.queue", "args": {"shown": {"type": "boolean"}}, "required": ["shown"],
     "actors": ["human", "brain"], "effects": [{"effect": "list.paged", "when": {"shown": true}}]},
    {"id": "queue.history.more", "label": "Read the next page of the Queue's dismissed items",
     "view": "right.queue", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "list.paged"}]},
    {"id": "queue.new", "label": "Open a new message, blank, in the centre (nothing is saved until it is written)",
     "view": "main.queue", "args": {}, "required": [], "actors": ["human", "brain"],
     "effects": [{"effect": "centre.view-shown"}, {"effect": "centre.detail-replaced"}, {"effect": "queue.draft-saved"}]},
    {"id": "queue.reply", "label": "Open the reply editor on the open item, answering one of its messages (nothing is saved until it is written)",
     "view": "main.queue", "args": {"messageId": {"type": "key", "entity": "message"}}, "required": ["messageId"],
     "actors": ["human", "brain"], "effects": []},
    {"id": "queue.draft.edit", "label": "Put a failed or cancelled response of the open item back in its editor (nothing is sent or saved)",
     "view": "main.queue", "args": {"messageId": {"type": "key", "entity": "message"}}, "required": ["messageId"],
     "actors": ["human", "brain"], "effects": []},
    {"id": "queue.message.show", "label": "Show one message: scrolled to in the open item, or its own item opened, with Back to this one",
     "view": "main.queue", "args": {"messageId": {"type": "key", "entity": "message"}}, "required": ["messageId"],
     "actors": ["human", "brain"],
     "effects": [{"effect": "centre.detail-replaced"}, {"effect": "queue.read-marked"}, {"effect": "queue.draft-saved"}]},
    {"id": "queue.discard.ask", "label": "Ask, or stop asking, whether to discard the open item's draft (nothing is discarded)",
     "view": "main.queue", "args": {"open": {"type": "boolean"}}, "required": ["open"],
     "actors": ["human", "brain"], "effects": []},
    {"id": "queue.done.ask", "label": "Show why the open item cannot be marked done yet, ask whether to discard its reply, or close that (nothing is discarded or dismissed)",
     "view": "main.queue", "args": {"step": {"type": "enum", "values": ["closed", "blockers", "discard"]}}, "required": ["step"],
     "actors": ["human", "brain"], "effects": []}
  ],
  "kinds": [
    {"kind": "queuePanel", "entity": null, "label": "Queue", "parts": ["waiting", "active", "history", "more", "new"],
     "presentations": [{"view": "right.queue", "reveal": {"command": "right.tab.select", "args": {"tab": "queue"}}}]},
    {"kind": "queueThread", "entity": "thread", "label": "Queue item",
     "parts": ["row", "sender", "subject", "receipt", "turn", "header", "back", "next", "close", "composer", "request"],
     "presentations": [{"view": "right.queue", "parts": ["row", "sender", "subject", "receipt", "turn"],
                        "reveal": {"command": "right.tab.select", "args": {"tab": "queue"}}},
                       {"view": "main.queue", "parts": ["header", "back", "next", "close", "composer", "request", "turn"],
                        "reveal": {"command": "queue.open", "args": {"threadId": "$key"}}}]},
    {"kind": "queueMessage", "entity": "message", "label": "Message", "parts": ["card", "request", "body", "receipt"],
     "presentations": [{"view": "main.queue"}]},
    {"kind": "queueAttachment", "entity": "attachment", "label": "Attachment",
     "parts": ["entry", "download", "location", "copy", "reveal", "openPage", "contents", "path", "more"],
     "presentations": [{"view": "main.queue"}]},
    {"kind": "bundleEntry", "entity": "member", "label": "File in an archive", "parts": ["name", "open"],
     "presentations": [{"view": "main.queue"}]}
  ]
}
