{
  "protocol": "jarvis.ui",
  "version": 1,
  "socket": "/ws/voice",
  "fromBrowser": ["ui_hello", "ui_event", "ui_result"],
  "fromServer": ["ui_welcome", "ui_request"],
  "regions": ["left", "right", "main", "overlay", "footer"],
  "actors": ["human", "brain"],
  "operations": ["map", "navigate", "indicate", "clear", "journey"],
  "statuses": ["completed", "not_found", "ambiguous", "not_visible", "blocked", "unavailable",
               "stale", "cancelled", "timeout", "busy", "expired", "invalid"],
  "lifecycle": ["resolving", "revealing", "emitting", "travelling", "arrived", "holding",
                "fading", "cleared", "cancelled"],
  "arrivals": ["animated", "static-reduced-motion"],
  "endpointStyles": ["outline", "circle", "brackets"],
  "revealModes": ["never", "navigate"],
  "visibility": ["visible", "offscreen", "hidden", "occluded", "unmounted"],
  "viewKinds": ["fixed", "tab", "detail", "modal", "menu"],
  "availabilityReasons": {
    "no-entity": "Nothing of that kind is open or listed.",
    "entity-gone": "That item is no longer listed.",
    "not-loaded": "That item is not loaded on this page yet.",
    "not-mounted": "That view is not on the page.",
    "hidden": "That view is on the page but hidden.",
    "occluded": "Something covers it.",
    "offscreen": "It is scrolled out of view.",
    "no-route": "No registered pipeline path reaches it.",
    "no-adapter": "That part has no registered geometry yet.",
    "not-signed-in": "This needs the team server, which is not signed in.",
    "actor-not-allowed": "That command is not offered to this caller.",
    "source-busy": "The orb is carrying a real transmission.",
    "quiet-page": "The page is quiet, so no animation is drawn."
  },
  "timing": {
    "emitMs": 220,
    "travelMs": 1400,
    "pulseCount": 3,
    "pulseOffsetMs": 170,
    "arrivalAtMs": 1620,
    "ringGapMs": 350,
    "holdUntilMs": 4400,
    "resetByMs": 5000,
    "maxExtraHoldMs": 6000,
    "ringMs": 700
  },
  "limits": {
    "requestTtlMs": 15000,
    "answerGraceMs": 1000,
    "revealWaitMs": 4000,
    "sourceQueueMs": 3000,
    "mapMaxTargets": 200,
    "journeyMaxSteps": 6,
    "labelMax": 80,
    "idMax": 64,
    "keyMax": 512
  },
  "entityKeys": {
    "node": "^[A-Za-z0-9-]{1,64}$",
    "server": "^server$",
    "session": "^[A-Za-z0-9._:-]{1,128}$",
    "workflow": "^[A-Za-z0-9._:-]{1,128}$",
    "subagent": "^[A-Za-z0-9._:-]{1,256}$",
    "workflowItem": "^[A-Za-z0-9._:-]{1,128}$",
    "thread": "^[A-Za-z0-9-]{1,64}$",
    "message": "^[A-Za-z0-9-]{1,64}$",
    "attachment": "^[A-Za-z0-9-]{1,64}$",
    "folder": "^[A-Za-z0-9-]{1,64}$",
    "folderEntry": "^[^\\u0000]{1,512}$",
    "candidate": "^[A-Za-z0-9-]{1,64}$",
    "subsystem": "^[a-z0-9_-]{1,64}$",
    "provider": "^[a-z0-9_-]{1,32}$",
    "capture": "^[0-9]{1,12}$",
    "record": "^[A-Za-z0-9._:-]{1,128}$",
    "incident": "^[A-Za-z0-9._:-]{1,128}$",
    "check": "^[A-Za-z0-9._:-]{1,128}$",
    "settingsSection": "^[a-z]{1,32}$"
  },
  "argumentTypes": ["enum", "string", "integer", "boolean", "key"],
  "sideEffects": {
    "agents.tab-attention-cleared": "Selecting Agents clears the Agents tab's attention mark.",
    "centre.view-shown": "A centre view is shown in place of the one that was.",
    "centre.detail-replaced": "The one detail slot of that kind now shows another entity.",
    "centre.detail-closed": "A centre detail closed and the centre went back to Conversation.",
    "queue.item-activated": "Opening a waiting queue item moves it to Active.",
    "queue.read-marked": "Showing a message body can mark it read.",
    "queue.draft-saved": "Leaving a reply editor saves its draft.",
    "settings.opened": "The Settings view opened.",
    "menu.opened": "The menu opened.",
    "list.paged": "A list loaded or showed another page.",
    "list.filtered": "A list's filter changed."
  },
  "pipeline": {
    "source": "orb.source",
    "junctions": [
      {"id": "orb.source", "region": "left", "label": "The main orb"},
      {"id": "trunk.orb", "region": "left", "label": "Top pipeline above the orb"},
      {"id": "rail.left.top", "region": "left", "label": "Left rail"},
      {"id": "rail.main.top", "region": "main", "label": "Main rail"},
      {"id": "rail.right.top", "region": "right", "label": "Right rail"},
      {"id": "rail.overlay.top", "region": "overlay", "label": "Overlay rail"},
      {"id": "rail.footer.top", "region": "footer", "label": "Footer rail"}
    ],
    "edges": [
      {"id": "edge.orb-rise", "from": "orb.source", "to": "trunk.orb", "region": "left"},
      {"id": "edge.trunk-left", "from": "trunk.orb", "to": "rail.left.top", "region": "left"},
      {"id": "edge.trunk-main", "from": "trunk.orb", "to": "rail.main.top", "region": "main"},
      {"id": "edge.trunk-right", "from": "rail.main.top", "to": "rail.right.top", "region": "right"},
      {"id": "edge.trunk-overlay", "from": "rail.main.top", "to": "rail.overlay.top", "region": "overlay"},
      {"id": "edge.trunk-footer", "from": "rail.left.top", "to": "rail.footer.top", "region": "footer"}
    ],
    "rails": [
      {"id": "rail.left", "region": "left", "top": "rail.left.top"},
      {"id": "rail.main", "region": "main", "top": "rail.main.top"},
      {"id": "rail.right", "region": "right", "top": "rail.right.top"},
      {"id": "rail.overlay", "region": "overlay", "top": "rail.overlay.top"},
      {"id": "rail.footer", "region": "footer", "top": "rail.footer.top"}
    ]
  },
  "families": [
    "families/shell.json",
    "families/network.json",
    "families/navigation.json",
    "families/left.json",
    "families/settings.json",
    "families/agents.json",
    "families/queue.json",
    "families/workflows.json",
    "families/diagnostics.json",
    "families/folders.json",
    "families/conversation.json"
  ]
}
