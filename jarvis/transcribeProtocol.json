{
  "path": "/ws/transcribe",
  "version": 2,
  "sampleRate": 16000,
  "channels": 1,
  "format": "pcm_s16le",
  "frameBytes": 3200,
  "maxFrameBytes": 6400,
  "queueLimitSec": 2.0,
  "startupBufferSec": 10.0,
  "interimEverySec": 0.2,
  "finishLimitSec": 5.0,
  "telemetryEverySec": 1.0,
  "fromBrowser": ["start", "finish", "abort", "telemetry"],
  "fromServer": ["loading", "ready", "interim", "final", "finished", "error", "health"],
  "dropReasons": ["fellBehind", "tooSlow", "backedUp", "disconnected", "lostJarvis"],
  "errors": ["busy", "taken", "model-unavailable", "invalid-format", "overload", "decoder-failed", "interrupted"]
}
